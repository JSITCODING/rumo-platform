{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Contrato inicial de design do Rumo. Valores aprovados para exploração visual; qualquer alteração exige revisão de contraste e registo.",
  "color": {
    "$type": "color",
    "palette": {
      "paper": {
        "$value": "#FFFDFC"
      },
      "ivory": {
        "$value": "#F7F3EA"
      },
      "sand": {
        "$value": "#E8E0D2"
      },
      "ink": {
        "$value": "#14201C"
      },
      "muted": {
        "$value": "#5F6B65"
      },
      "green900": {
        "$value": "#173F34"
      },
      "green700": {
        "$value": "#286150"
      },
      "green100": {
        "$value": "#DCEBE5"
      },
      "terracotta": {
        "$value": "#B85F3E"
      },
      "terracotta100": {
        "$value": "#F3E3DC"
      },
      "gold": {
        "$value": "#A77A2D"
      },
      "gold100": {
        "$value": "#F3E8CE"
      },
      "red700": {
        "$value": "#9B3434"
      },
      "red100": {
        "$value": "#F7DFDF"
      },
      "white": {
        "$value": "#FFFFFF"
      }
    },
    "semantic": {
      "background": {
        "canvas": {
          "$value": "{color.palette.ivory}"
        },
        "surface": {
          "$value": "{color.palette.paper}"
        },
        "subtle": {
          "$value": "{color.palette.green100}"
        }
      },
      "text": {
        "primary": {
          "$value": "{color.palette.ink}"
        },
        "secondary": {
          "$value": "{color.palette.muted}"
        },
        "inverse": {
          "$value": "{color.palette.white}"
        },
        "link": {
          "$value": "{color.palette.green900}"
        }
      },
      "border": {
        "default": {
          "$value": "{color.palette.sand}"
        },
        "strong": {
          "$value": "{color.palette.muted}"
        },
        "focus": {
          "$value": "{color.palette.green700}"
        }
      },
      "action": {
        "primary": {
          "$value": "{color.palette.green900}"
        },
        "primaryHover": {
          "$value": "{color.palette.green700}"
        },
        "secondary": {
          "$value": "{color.palette.paper}"
        },
        "disabled": {
          "$value": "{color.palette.sand}"
        }
      },
      "accent": {
        "warm": {
          "$value": "{color.palette.terracotta}"
        },
        "gold": {
          "$value": "{color.palette.gold}"
        }
      },
      "status": {
        "success": {
          "$value": "{color.palette.green700}"
        },
        "successSubtle": {
          "$value": "{color.palette.green100}"
        },
        "warning": {
          "$value": "{color.palette.gold}"
        },
        "warningSubtle": {
          "$value": "{color.palette.gold100}"
        },
        "danger": {
          "$value": "{color.palette.red700}"
        },
        "dangerSubtle": {
          "$value": "{color.palette.red100}"
        }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Newsreader",
          "Georgia",
          "serif"
        ]
      },
      "body": {
        "$value": [
          "Manrope",
          "system-ui",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "size": {
      "$type": "dimension",
      "caption": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "bodySmall": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "body": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "titleSmall": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "title": {
        "$value": {
          "value": 28,
          "unit": "px"
        }
      },
      "display": {
        "$value": {
          "value": 42,
          "unit": "px"
        }
      },
      "displayDesktop": {
        "$value": {
          "value": 64,
          "unit": "px"
        }
      }
    },
    "lineHeight": {
      "$type": "number",
      "tight": {
        "$value": 1.1
      },
      "heading": {
        "$value": 1.2
      },
      "body": {
        "$value": 1.55
      }
    }
  },
  "space": {
    "0": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "1": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "2": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "3": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "4": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "5": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "6": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "8": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "10": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    },
    "12": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "16": {
      "$value": {
        "value": 64,
        "unit": "px"
      }
    },
    "20": {
      "$value": {
        "value": 80,
        "unit": "px"
      }
    },
    "$type": "dimension"
  },
  "radius": {
    "$type": "dimension",
    "small": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "medium": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "large": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "size": {
    "$type": "dimension",
    "control": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "iconSmall": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "icon": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "contentMobile": {
      "$value": {
        "value": 360,
        "unit": "px"
      }
    },
    "contentDesktop": {
      "$value": {
        "value": 1200,
        "unit": "px"
      }
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "mobileBase": {
      "$value": {
        "value": 360,
        "unit": "px"
      }
    },
    "tablet": {
      "$value": {
        "value": 768,
        "unit": "px"
      }
    },
    "desktop": {
      "$value": {
        "value": 1440,
        "unit": "px"
      }
    }
  },
  "motion": {
    "duration": {
      "$type": "number",
      "fast": {
        "$value": 160
      },
      "standard": {
        "$value": 220
      },
      "slow": {
        "$value": 320
      },
      "$description": "Duração em milissegundos; Penpot não suporta o tipo DTCG duration."
    }
  }
}
