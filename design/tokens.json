{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Rumo Editorial Documental v0.2 — contrato aberto para Penpot e futura implementação.",
  "color": {
    "$type": "color",
    "palette": {
      "paper": { "$value": "#FFFDFC" },
      "ivory": { "$value": "#F7F3EA" },
      "rule": { "$value": "#D8D0C2" },
      "ink": { "$value": "#16211D" },
      "muted": { "$value": "#5F6B65" },
      "green900": { "$value": "#173F34" },
      "green700": { "$value": "#286150" },
      "green100": { "$value": "#DCEBE5" },
      "terracotta": { "$value": "#AD5132" },
      "terracotta100": { "$value": "#F3E3DC" },
      "gold": { "$value": "#895F20" },
      "gold100": { "$value": "#F2E7CB" },
      "red700": { "$value": "#913B35" },
      "red100": { "$value": "#F5DFDC" },
      "white": { "$value": "#FFFFFF" }
    },
    "semantic": {
      "background": {
        "canvas": { "$value": "{color.palette.ivory}" },
        "surface": { "$value": "{color.palette.paper}" },
        "subtle": { "$value": "{color.palette.green100}" }
      },
      "text": {
        "primary": { "$value": "{color.palette.ink}" },
        "secondary": { "$value": "{color.palette.muted}" },
        "inverse": { "$value": "{color.palette.white}" },
        "link": { "$value": "{color.palette.green900}" }
      },
      "border": {
        "default": { "$value": "{color.palette.rule}" },
        "strong": { "$value": "{color.palette.muted}" },
        "focus": { "$value": "{color.palette.green700}" }
      },
      "action": {
        "primary": { "$value": "{color.palette.green900}" },
        "primaryHover": { "$value": "{color.palette.green700}" },
        "disabled": { "$value": "{color.palette.rule}" }
      },
      "accent": {
        "warm": { "$value": "{color.palette.terracotta}" },
        "gold": { "$value": "{color.palette.gold}" }
      },
      "status": {
        "success": { "$value": "{color.palette.green700}" },
        "successSubtle": { "$value": "{color.palette.green100}" },
        "warning": { "$value": "{color.palette.gold}" },
        "warningSubtle": { "$value": "{color.palette.gold100}" },
        "danger": { "$value": "{color.palette.red700}" },
        "dangerSubtle": { "$value": "{color.palette.red100}" }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Literata", "Georgia", "serif"] },
      "body": { "$value": ["IBM Plex Sans", "Arial", "sans-serif"] },
      "metadata": { "$value": ["IBM Plex Mono", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "caption": { "$value": { "value": 12, "unit": "px" } },
      "bodySmall": { "$value": { "value": 14, "unit": "px" } },
      "body": { "$value": { "value": 16, "unit": "px" } },
      "titleSmall": { "$value": { "value": 20, "unit": "px" } },
      "title": { "$value": { "value": 28, "unit": "px" } },
      "display": { "$value": { "value": 42, "unit": "px" } },
      "displayDesktop": { "$value": { "value": 64, "unit": "px" } }
    },
    "lineHeight": {
      "$type": "number",
      "tight": { "$value": 1.05 },
      "heading": { "$value": 1.15 },
      "body": { "$value": 1.5 }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "5": { "$value": { "value": 20, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "7": { "$value": { "value": 28, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } },
    "10": { "$value": { "value": 40, "unit": "px" } },
    "16": { "$value": { "value": 64, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "small": { "$value": { "value": 4, "unit": "px" } },
    "medium": { "$value": { "value": 8, "unit": "px" } },
    "large": { "$value": { "value": 12, "unit": "px" } },
    "pill": { "$value": { "value": 999, "unit": "px" } }
  },
  "stroke": {
    "$type": "dimension",
    "hairline": { "$value": { "value": 1, "unit": "px" } },
    "strong": { "$value": { "value": 2, "unit": "px" } },
    "editorial": { "$value": { "value": 4, "unit": "px" } }
  },
  "breakpoint": {
    "$type": "dimension",
    "mobileBase": { "$value": { "value": 360, "unit": "px" } },
    "tablet": { "$value": { "value": 768, "unit": "px" } },
    "desktop": { "$value": { "value": 1440, "unit": "px" } }
  }
}
