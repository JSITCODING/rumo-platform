{
  "name": "rumo-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "postbuild": "node scripts/prepare-pages.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "contrast": "node --experimental-strip-types scripts/contrast.ts --check",
    "contrast:update": "node --experimental-strip-types scripts/contrast.ts --write",
    "check": "npm run contrast && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "motion": "12.23.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "framer-motion": "12.23.24",
    "motion-dom": "12.23.23",
    "motion-utils": "12.23.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
